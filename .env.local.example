# Express API origin. Next.js proxies /api/v1/* to it (next.config.ts rewrites),
# so the backend's httpOnly cookies stay first-party.
API_ORIGIN=http://localhost:4000

# Shown in the sticky footer.
NEXT_PUBLIC_APP_VERSION=1.0.0

# Optional: the API's public URL if it differs from API_ORIGIN (signed file links point there;
# it is allowed in the Content-Security-Policy for images / PDFs).
# API_PUBLIC_URL=https://api.example.com

# --- Observability (optional; everything is off while these are empty — see README "Observability") ---
# Sentry error + performance monitoring. Browser + Next.js server use NEXT_PUBLIC_SENTRY_DSN;
# SENTRY_DSN overrides it on the server only. The DSN's ingest host is added to the CSP connect-src.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_RELEASE=web@1.0.0
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload at build time (CI only; the build plugin is skipped without the token).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# PostHog product analytics (only the `login` event from the web; autocapture / recording off).
# The host (and its -assets host on PostHog Cloud) is added to the CSP connect-src.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
